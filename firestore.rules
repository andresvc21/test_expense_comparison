rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Wage documents scoped by UUID-based user ID
    match /wages/{docId} {
      allow read, write: if docId.matches('^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$');

      // Wage history subcollection
      match /history/{entryId} {
        allow read, write: if docId.matches('^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$');
      }
    }

    // Block everything else
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
